# Public site contact (shown in footer, click-to-call, WhatsApp)
NEXT_PUBLIC_PHONE="+971 54 414 1077"
NEXT_PUBLIC_PHONE_TEL="+971544141077"
NEXT_PUBLIC_WHATSAPP="971544141077"
NEXT_PUBLIC_EMAIL="hello@seedrixtraining.com"
NEXT_PUBLIC_INSTAGRAM=""
NEXT_PUBLIC_LINKEDIN=""
# Also used for staff portal email links (invites, magic links, password reset)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Team notification inbox for new inquiries
SEEDRIX_TEAM_EMAIL="hello@seedrixtraining.com"

# Supabase
# URL + anon (public) key: used by the staff portal (/admin) with each user's
# own login, so every query is checked by Postgres row level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: server-only. Used by the public site's API routes, staff
# invites (Settings -> Staff) and the workbook importer. Never expose it to the
# browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
RESEND_FROM="Seedrix Training <noreply@seedrixtraining.com>"

# Invoice admin (Recruits create quoted invoices with this secret)
INVOICE_ADMIN_SECRET=

# Network International N-Genius Online
# Leave PAYMENT_PROVIDER=mock to test invoice generation without a merchant account.
PAYMENT_PROVIDER="mock"
NGENIUS_API_KEY=
NGENIUS_OUTLET_ID=
NGENIUS_WEBHOOK_SECRET=
# sandbox: https://api-gateway.sandbox.ngenius-payments.com
# live:     https://api-gateway.ngenius-payments.com
NGENIUS_API_BASE="https://api-gateway.sandbox.ngenius-payments.com"

# Self-serve online tutoring pack prices in AED (leave blank to show [X] placeholders)
ONLINE_10H_AED=
ONLINE_20H_AED=
